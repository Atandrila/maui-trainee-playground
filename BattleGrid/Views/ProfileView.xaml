<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BattleGrid.ViewModels"
             x:Class="BattleGrid.Views.ProfileView"
             x:DataType="vm:ProfileViewModel"
             Title="{Binding ProfileTitleText}" BackgroundColor="#79C9EB">
    <ScrollView>
        <VerticalStackLayout Padding="18,18,18,28" Spacing="14">
            <Label Text="{Binding PersonnelSectionText}" FontSize="10" FontAttributes="Bold" TextColor="#1C6587"/>
            <Label Text="{Binding CaptainDossierText}" FontSize="27" FontAttributes="Bold" TextColor="#07365A"/>

            <Border Style="{StaticResource OceanPanelStyle}" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                        <Border Style="{x:Null}" Stroke="#6DBDDD" StrokeThickness="2" Background="#216F98"
                                WidthRequest="68" HeightRequest="68" StrokeShape="RoundRectangle 15" Padding="8">
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                                <Label Text="BG" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center"/>
                                <Label Text="{Binding EmblemNavyText}" FontSize="9" TextColor="#CAEAF8" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="{Binding FleetCommanderText}" TextColor="#FFBC58" FontSize="11" FontAttributes="Bold"/>
                            <Label Text="{Binding CaptainName}" FontSize="22" FontAttributes="Bold" TextColor="White" LineBreakMode="TailTruncation"/>
                            <Label Text="{Binding Rank}" FontSize="14" TextColor="#BCEEFF"/>
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#3B86AA"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding ServiceLevelText}" TextColor="#CAEAF8" FontSize="12"/>
                        <Label Grid.Column="1" Text="{Binding Level}" FontAttributes="Bold" TextColor="#FFA62B" FontSize="17"/>
                    </Grid>
                    <ProgressBar Progress="{Binding LevelProgress}" ProgressColor="#FFA62B" BackgroundColor="#387A9A" HeightRequest="8"/>
                    <Label Text="{Binding LevelProgressText}" TextColor="#CAEAF8" FontSize="11"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding ServiceRecordText}" FontSize="15" FontAttributes="Bold" TextColor="#07365A"/>
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource LightPanelStyle}" Padding="12">
                    <VerticalStackLayout Spacing="4"><Label Text="{Binding VictoriesText}" FontSize="10" TextColor="#386989" FontAttributes="Bold"/><Label Text="{Binding Wins}" FontSize="27" FontAttributes="Bold" TextColor="#07365A"/></VerticalStackLayout>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource LightPanelStyle}" Padding="12">
                    <VerticalStackLayout Spacing="4"><Label Text="{Binding LossesText}" FontSize="10" TextColor="#386989" FontAttributes="Bold"/><Label Text="{Binding Losses}" FontSize="27" FontAttributes="Bold" TextColor="#07365A"/></VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource LightPanelStyle}" Padding="12">
                    <VerticalStackLayout Spacing="4"><Label Text="{Binding CurrentStreakText}" FontSize="10" TextColor="#386989" FontAttributes="Bold"/><Label Text="{Binding CurrentStreak}" FontSize="27" FontAttributes="Bold" TextColor="#07365A"/></VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource LightPanelStyle}" Padding="12">
                    <VerticalStackLayout Spacing="4"><Label Text="{Binding BestStreakText}" FontSize="10" TextColor="#386989" FontAttributes="Bold"/><Label Text="{Binding BestStreak}" FontSize="27" FontAttributes="Bold" TextColor="#07365A"/></VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource OceanPanelStyle}" Padding="15">
                <VerticalStackLayout Spacing="9">
                    <Label Text="{Binding CaptainSettingsText}" FontSize="15" FontAttributes="Bold" TextColor="#FFBC58"/>
                    <Label Text="{Binding CaptainNameLabelText}" FontSize="11" TextColor="#CAEAF8"/>
                    <Border Style="{x:Null}" Background="#E0F4FE" Stroke="#7FC5E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="5,0">
                        <Entry Text="{Binding CaptainName, Mode=TwoWay}" MaxLength="24" Placeholder="{Binding CaptainNamePlaceholderText}" TextColor="#07365A" PlaceholderColor="#527B90" BackgroundColor="Transparent"/>
                    </Border>
                    <Label Text="{Binding PreferredDifficultyText}" FontSize="11" TextColor="#CAEAF8"/>
                    <Border Style="{x:Null}" Background="#E0F4FE" Stroke="#7FC5E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="5,0">
                        <Picker ItemsSource="{Binding Difficulties}" SelectedIndex="{Binding SelectedDifficultyIndex, Mode=TwoWay}" TextColor="#07365A" BackgroundColor="Transparent"/>
                    </Border>
                    <Label Text="{Binding LanguageLabelText}" FontSize="11" TextColor="#CAEAF8"/>
                    <Border Style="{x:Null}" Background="#E0F4FE" Stroke="#7FC5E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="5,0">
                        <Picker ItemsSource="{Binding Languages}" SelectedIndex="{Binding SelectedLanguageIndex, Mode=TwoWay}" TextColor="#07365A" BackgroundColor="Transparent" />
                    </Border>
                    <Label Text="{Binding LanguageHintText}" FontSize="11" TextColor="#CAEAF8" LineBreakMode="WordWrap" />
                    <Button Text="{Binding SaveCaptainProfileText}" Command="{Binding SaveCommand}" BackgroundColor="#FFA62B" TextColor="#092C49" FontAttributes="Bold" CornerRadius="10" HeightRequest="46"/>
                    <Label Text="{Binding StatusMessage}" FontSize="12" TextColor="#CAEAF8" LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource LightPanelStyle}" Padding="15">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding MedalsAchievementsText}" TextColor="#07365A" FontAttributes="Bold" FontSize="15"/>
                    <Label Text="{Binding Achievements}" FontSize="13" TextColor="#386989" LineBreakMode="WordWrap"/>
                    <Label Text="{Binding MedalsHintText}" FontSize="11" TextColor="#386989"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
